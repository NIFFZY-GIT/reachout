generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  ADMIN
}

enum ConversationStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum DeletionStatus {
  NONE
  PENDING
  COMPLETED
}

enum SafetyFlag {
  NORMAL
  NEEDS_ATTENTION
  URGENT_SAFETY_CONCERN
}

model User {
  id          String         @id @default(uuid())
  username    String         @unique
  email       String?        @unique
  passwordHash String
  role        Role           @default(USER)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lastSeen    DateTime?
  isActive    Boolean        @default(true)
  sessions    UserSession[]
  conversations Conversation[]
  adminNotes  AdminNote[]
}

model UserSession {
  id              String    @id @default(uuid())
  userId          String
  sessionTokenHash String   @unique
  createdAt       DateTime  @default(now())
  lastActivityAt  DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Conversation {
  id                 String             @id @default(uuid())
  userId             String
  status             ConversationStatus @default(OPEN)
  safetyFlag         SafetyFlag         @default(NORMAL)
  lastMessage        String?
  lastMessageAt      DateTime?
  lastMessageSender  Role?
  adminUnreadCount   Int                @default(0)
  userUnreadCount    Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletionScheduledAt DateTime?
  deletionStatus     DeletionStatus     @default(NONE)
  userTypingUntil    DateTime?
  adminTypingUntil   DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMessages       UserMessage[]
  adminMessages      AdminMessage[]
  adminNotes         AdminNote[]

  @@index([userId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([deletionStatus, deletionScheduledAt])
}

model UserMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  senderRole     Role
  text           String
  messageType    String       @default("TEXT")
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AdminMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  senderRole     Role
  text           String
  messageType    String       @default("TEXT")
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AdminNote {
  id             String       @id @default(uuid())
  conversationId String
  adminId        String
  note           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  admin          User         @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
